#!/bin/sh
# SysV init script for the POSIX launcher:
#   cp contrib/S99startup /etc/init.d/  (or /etc/rc2.d/S99startup)
case "$1" in
  start)
    # config is resolved as /usr/local/bin/../conf/startup.conf;
    # -d detaches the supervisor, which then serves the control
    # interface on /tmp/bootlauncher.ctl for 'app' commands
    /usr/local/bin/startup -d serve
    ;;
  stop)
    # stop only the supervisor; applications keep running
    /usr/local/bin/startup app shutdown
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    /usr/local/bin/startup app status
    ;;
  *)
    echo "usage: $0 start|stop|restart|status" >&2
    exit 1
    ;;
esac
exit 0
