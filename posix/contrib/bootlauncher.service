# systemd unit for the POSIX launcher:
#   cp contrib/bootlauncher.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable bootlauncher.service
[Unit]
Description=Boot-time application launcher (dependency ordered)
After=local-fs.target network.target

[Service]
Type=simple
# Supervisor mode: boot everything at startup, then stay resident and
# serve the control interface (/tmp/bootlauncher.ctl, env
# BOOTLAUNCHER_CTL) for user processes:
#   bootlauncher app start|stop|restart <name> | status [name] | list | ping
# KillMode=mixed: `systemctl stop' sends SIGTERM to the supervisor only;
# the application processes it launched keep running.
KillMode=mixed
TimeoutStopSec=10
# no -c needed: the binary reads <exe dir>/../conf/startup.conf
# = /usr/local/conf/startup.conf
ExecStart=/usr/local/bin/bootlauncher serve

[Install]
WantedBy=multi-user.target
