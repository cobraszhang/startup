/* appboot.rc - Win32 VERSIONINFO resource for the launcher executables.
 *
 * NOTE: the numeric FILEVERSION/PRODUCTVERSION must be kept in sync with
 * src/version.h (currently 0.2.5). Strings are ASCII only so that both
 * rc.exe (VC6) and windres (MinGW) embed them identically.
 * Build: windres -i appboot.rc -o appboot.res, then link appboot.res.
 */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,5,0
 PRODUCTVERSION 0,2,5,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",  "startup\0"
            VALUE "FileDescription", "startup\0"
            VALUE "FileVersion",     "0.2.5\0"
            VALUE "ProductVersion",  "0.2.5\0"
            VALUE "ProductName",     "startup\0"
            VALUE "InternalName",    "startup\0"
            VALUE "OriginalFilename","startup.exe\0"
            VALUE "LegalCopyright",  "Unpublished / Proprietary\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
